{
  "author": "Jason Williscroft",
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "unreleased": true,
    "commitLimit": false,
    "hideCredit": true
  },
  "bugs": {
    "url": "https://github.com/karmaniverous/aws-xray-tools/issues"
  },
  "description": "Guarded AWS X-Ray capture utilities for AWS SDK v3 clients.",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "auto-changelog": "^2.7.0",
    "aws-xray-sdk": "^3.12.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "fs-extra": "^11.4.1",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "release-it": "^21.1.2",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.4",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-replace-text": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/mjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/karmaniverous/aws-xray-tools#readme",
  "keywords": [
    "typescript",
    "aws",
    "xray",
    "aws-xray",
    "tracing",
    "observability",
    "aws-sdk",
    "aws-sdk-v3"
  ],
  "license": "BSD-3-Clause",
  "main": "dist/mjs/index.js",
  "name": "@karmaniverous/aws-xray-tools",
  "peerDependencies": {
    "aws-xray-sdk": "^3.12.0"
  },
  "peerDependenciesMeta": {
    "aws-xray-sdk": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx auto-changelog --unreleased-only --stdout --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs",
      "commitMessage": "chore: release v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:init": [
        "npm run lint",
        "npm run test",
        "npm run knip",
        "npm run build"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ],
      "after:bump": [
        "npx auto-changelog -p",
        "npm run docs",
        "git add CHANGELOG.md"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karmaniverous/aws-xray-tools.git"
  },
  "scripts": {
    "build": "rimraf dist && tsx ./node_modules/rollup/dist/bin/rollup --config rollup.config.ts",
    "changelog": "auto-changelog",
    "docs": "typedoc",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "release": "dotenvx run -f ./.env.local -- release-it",
    "release:pre": "npm run release -- --no-git.requireBranch --github.prerelease --preRelease",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.2.2",
  "allowScripts": {
    "esbuild": true,
    "lefthook": true,
    "fsevents": true
  },
  "overrides": {
    "proxy-agent": "8.0.3"
  }
}
